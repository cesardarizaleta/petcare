### PetCare Backend Reporting & Performance API Requests

# Global variables for testing environment
@baseUrl = http://localhost:8000
@token = YOUR_JWT_ACCESS_TOKEN_HERE

###
# @name 1_LoginManager
# 1. Get JWT Access Token (Manager Role)
# This request logs in and returns the access token required for metrics.
POST {{baseUrl}}/api/v1/auth/login/
Content-Type: application/json

{
  "email": "manager_test@petcare.com",
  "password": "Password123!"
}

### Expected Response (200 OK):
# {
#   "access": "eyJhbGciOiJIUzI1NiIsIn...",
#   "refresh": "eyJhbGciOiJIUzI1NiIsIn...",
#   "user": {
#     "id": "e4f8d9b2-...",
#     "email": "manager_test@petcare.com",
#     "first_name": "Admin",
#     "last_name": "Gerente",
#     "groups": ["manager"]
#   }
# }


###
# @name 2_GetDashboardSummaryPeriod
# 2. Get Dashboard Summary (Predefined Period)
# Returns aggregate KPIs and chart data points for 'este_mes', 'esta_semana', or 'hoy'.
GET {{baseUrl}}/api/v1/reporting/dashboard/?periodo=este_mes
Authorization: Bearer {{token}}
Accept: application/json

### Expected Response (200 OK):
# {
#   "period": "este_mes",
#   "from": "2026-06-01",
#   "to": "2026-06-02",
#   "has_data": true,
#   "kpis": [
#     {
#       "id": "brecha",
#       "title": "Presupuesto de Compras",
#       "value": "$450.00",
#       "icon": "layout-dashboard",
#       "status": "success"
#     },
#     ...
#   ],
#   "revenueData": [
#     { "label": "2026-06-01", "amount": 450.0 }
#   ]
# }


###
# @name 3_GetDashboardSummaryCustomDates
# 3. Get Dashboard Summary (Custom Date Range - English 'from' & 'to')
# Returns aggregate KPIs and chart data points for specific, exact dates.
GET {{baseUrl}}/api/v1/reporting/dashboard/?from=2026-05-15&to=2026-06-02
Authorization: Bearer {{token}}
Accept: application/json

### Expected Response (200 OK):
# {
#   "period": "este_mes",
#   "from": "2026-05-15",
#   "to": "2026-06-02",
#   "has_data": true,
#   "kpis": [...],
#   "revenueData": [...]
# }


###
# @name 4_GetKPIsOnly
# 4. Get KPIs list (Custom Date Range - English 'from' & 'to')
# Returns only the list of the 5 operational KPIs.
GET {{baseUrl}}/api/v1/reporting/kpis/?from=2026-05-15&to=2026-06-02
Authorization: Bearer {{token}}
Accept: application/json

### Expected Response (200 OK):
# [
#   {
#     "id": "brecha",
#     "title": "Presupuesto de Compras",
#     "value": "$450.00",
#     "icon": "layout-dashboard",
#     "status": "success"
#   },
#   ...
# ]


###
# @name 5_GetRevenueData
# 5. Get Revenue Chart Data (Custom Date Range - English 'from' & 'to')
# Returns only the grouped data points for the dashboard chart.
GET {{baseUrl}}/api/v1/reporting/revenue/?from=2026-05-15&to=2026-06-02
Authorization: Bearer {{token}}
Accept: application/json

### Expected Response (200 OK):
# [
#   { "label": "2026-06-01", "amount": 450.0 }
# ]


###
# @name 6_ExportReportCSV
# 6. Generate and Export Detailed Report (CSV Format)
# Triggers download of the report in CSV format for a custom range.
GET {{baseUrl}}/api/v1/reporting/export/?from=2026-05-15&to=2026-06-02&export_format=csv
Authorization: Bearer {{token}}

### Expected Response (200 OK + Attachment Download):
# Content-Type: text/csv; charset=utf-8-sig
# Content-Disposition: attachment; filename="reporte_desempeno_este_mes_2026-05-15_al_2026-06-02.csv"
#
# ==================================================
# REPORTE DE DESEMPEÑO Y RENDIMIENTO - CLINICA PETCARE
# ==================================================
# Periodo del Reporte:,2026-05-15 al 2026-06-02 (ESTE_MES)
# Fecha de Generación:,2026-06-02 14:39:47
# ...


###
# @name 7_ExportReportJSON
# 7. Generate and Export Detailed Report (JSON Format)
# Triggers download of the report in JSON format for a custom range.
GET {{baseUrl}}/api/v1/reporting/export/?from=2026-05-15&to=2026-06-02&export_format=json
Authorization: Bearer {{token}}

### Expected Response (200 OK + Attachment Download):
# Content-Type: application/json; charset=utf-8
# Content-Disposition: attachment; filename="reporte_desempeno_este_mes_2026-05-15_al_2026-06-02.json"
#
# {
#   "report_metadata": {
#     "period": "este_mes",
#     "from": "2026-05-15",
#     "to": "2026-06-02",
#     "generated_at": "2026-06-02 14:39:47"
#   },
#   "kpis": [...],
#   "appointments": [...],
#   "purchase_orders": [...]
# }
