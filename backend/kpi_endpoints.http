###
# @name 3_GetKPIsOnly
# 3. Lista de Indicadores Clave de Desempeño (KPIs)
# Devuelve de forma exclusiva la colección formateada de los 5 KPIs operacionales.
GET {{baseUrl}}/api/v1/reporting/kpis/?periodo=esta_semana
Authorization: Bearer {{token}}
Accept: application/json

### Response Esperada (200 OK):
# [
#   {
#     "id": "brecha",
#     "title": "Presupuesto de Compras",
#     "value": "$0.00",
#     "icon": "layout-dashboard",
#     "status": "success"
#   },
#   ...
# ]


###
# @name 4_GetRevenueData
# 4. Puntos de Gráfico de Compras / Ingresos
# Devuelve montos agrupados para la gráfica del dashboard según temporalidad.
GET {{baseUrl}}/api/v1/reporting/revenue/?periodo=hoy
Authorization: Bearer {{token}}
Accept: application/json

### Response Esperada (200 OK):
# [
#   { "label": "2026-06-02", "amount": 0.0 }
# ]


###
# @name 5_ExportReportCSV
# 5. Generar y Exportar Reporte de Desempeño (Formato CSV)
# Retorna un flujo binario para descarga directa con cabeceras de metadatos, KPIs, consultas y compras.
GET {{baseUrl}}/api/v1/reporting/export/?periodo=este_mes&export_format=csv
Authorization: Bearer {{token}}

### Response Esperada (200 OK + Descarga Directa):
# Content-Type: text/csv; charset=utf-8-sig
# Content-Disposition: attachment; filename="reporte_desempeno_este_mes_2026-06-01_al_2026-06-02.csv"
#
# ==================================================
# REPORTE DE DESEMPEÑO Y RENDIMIENTO - CLINICA PETCARE
# ==================================================
# Periodo del Reporte:,2026-06-01 al 2026-06-02 (ESTE_MES)
# Fecha de Generación:,2026-06-02 14:39:47
# ...


###
# @name 6_ExportReportJSON
# 6. Generar y Exportar Reporte de Desempeño (Formato JSON)
# Genera un archivo estructurado JSON descargable con todo el desglose crudo de la base de datos.
GET {{baseUrl}}/api/v1/reporting/export/?periodo=este_mes&export_format=json
Authorization: Bearer {{token}}

### Response Esperada (200 OK + Descarga Directa):
# Content-Type: application/json; charset=utf-8
# Content-Disposition: attachment; filename="reporte_desempeno_este_mes_2026-06-01_al_2026-06-02.json"
#
# {
#   "report_metadata": {
#     "period": "este_mes",
#     "start_date": "2026-06-01",
#     "end_date": "2026-06-02",
#     "generated_at": "2026-06-02 14:39:47"
#   },
#   "kpis": [...],
#   "appointments": [...],
#   "purchase_orders": [...]
# }
